{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [
      ".opencode/skills",
      ".agents/skills"
    ]
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{file:.secrets/context7.key}"
      },
      "enabled": true
    },
    "testsprite": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@testsprite/testsprite-mcp@latest"
      ],
      "environment": {
        "API_KEY": "{file:.secrets/testsprite.key}"
      },
      "enabled": true
    }
  }
}
