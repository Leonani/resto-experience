# ─────────────────────────────────────────────────────────────────────────────
# Dependencias
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─────────────────────────────────────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────────────────────────────────────
# `out/` solo aplica con output estático. Este proyecto no lo usa, pero dejarlo
# ignorado es barato y evita comitear un build por error.
/out/
.next/
next-env.d.ts

# ─────────────────────────────────────────────────────────────────────────────
# Secretos — la regla que importa
# ─────────────────────────────────────────────────────────────────────────────
# Todo `.env*` está ignorado, y `.env.example` se vuelve a incluir con `!`.
# El orden importa: el patrón general va PRIMERO y la excepción DESPUÉS.
.env*
!.env.example

# Credenciales de herramientas (MCP y similares), referenciadas desde
# `opencode.json` con `{file:.secrets/<nombre>.key}`. Van aparte de `.env*` a
# propósito: `.env*` es para la app Next.js y estas claves no tienen nada que
# ver con ella. Tener una credencial de Context7 flotando en el entorno del
# servidor Next es justo el tipo de cosa que un `console.log` termina filtrando.
.secrets/

# Cinturones y tirantes. `.env*` ya cubre los casos normales; estos atrapan los
# nombres de siempre cuando alguien los crea con otro sufijo.
*.pem
*.key
*.p12
*.pfx
service-role*.json
secrets.json

# ─────────────────────────────────────────────────────────────────────────────
# Tests y coverage
# ─────────────────────────────────────────────────────────────────────────────
coverage/
.vitest/

