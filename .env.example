# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env.local y completar. NUNCA commitear .env.local
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yambwmddmtpssvhwbrlx.supabase.co

# Anon key — SOLO lectura. Es publica por diseño: se expone al navegador.
# Va con prefijo NEXT_PUBLIC_ a propósito.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO servidor. bypasea RLS: puede escribir en todas las
# tablas. Si se filtra, hay que rotarla en el dashboard de Supabase.
# SIN prefijo NEXT_PUBLIC_: nunca debe llegar al bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Token de importación
# ─────────────────────────────────────────────────────────────────────────────
# POST /api/import es un endpoint DESTRUCTIVO: reescribe el catálogo. Sin token
# queda cerrado (503) a propósito, porque abierto cualquiera que conozca la URL
# podría reescribir los datos.
#
# Generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Llamarlo:
#   curl -X POST http://localhost:3000/api/import -H "x-import-token: <TOKEN>"
IMPORT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Borrador IA (opcional) — OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
# La app funciona SIN esto: usa el template local de lib/draft/provider.ts y lo
# marca explícitamente (fromFallback). Solo se hace una llamada real si hay key.
#
# Llamada real (OpenRouter, compatible con la API de OpenAI):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=anthropic/claude-3.5-haiku
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#
# LLM_BASE_URL permite apuntar a cualquier proveedor compatible con /chat/completions.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
