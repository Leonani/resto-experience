# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env.local y completar. NUNCA commitear .env.local
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yambwmddmtpssvhwbrlx.supabase.co

# Anon / publishable key — SOLO lectura. Es publica por diseño: se expone al
# navegador. Va con prefijo NEXT_PUBLIC_ a propósito.
# Formato nuevo de Supabase: sb_publishable_... (las legacy anon JWT siguen
# funcionando; el nombre de la variable no cambia).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — SOLO servidor. bypasea RLS: puede escribir en
# todas las tablas. Si se filtra, hay que rotarla en el dashboard de Supabase.
# Formato nuevo: sb_secret_... (las legacy service_role JWT siguen valiendo).
# SIN prefijo NEXT_PUBLIC_: nunca debe llegar al bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Token de importación
# ─────────────────────────────────────────────────────────────────────────────
# POST /api/import es un endpoint DESTRUCTIVO: reescribe el catálogo. Sin token
# queda cerrado (503) a propósito, porque abierto cualquiera que conozca la URL
# podría reescribir los datos.
#
# Generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Llamarlo:
#   curl -X POST http://localhost:3000/api/import -H "x-import-token: <TOKEN>"
IMPORT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Borrador IA (opcional) — OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
# La app funciona SIN esto: usa el template local de lib/draft/provider.ts y lo
# marca explícitamente (fromFallback). Solo se hace una llamada real si hay key.
#
# Llamada real (OpenRouter, compatible con la API de OpenAI):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=anthropic/claude-3.5-haiku
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#
# LLM_BASE_URL permite apuntar a cualquier proveedor compatible con /chat/completions.
#
# LLM_APP_TITLE y LLM_APP_URL no cambian la respuesta: solo identifican la app en
# el dashboard del proveedor. Defaults si se dejan vacíos:
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_APP_TITLE=
LLM_APP_URL=

# -------------------------------------------------------------------------------
# Límites de generación IA (protección de costos)
# -------------------------------------------------------------------------------
# La llamada real al proveedor es el único punto que gasta plata. Antes de llamar
# se cuentan los intentos reales de IA de la última hora / 24 h en audit_logs, y
# al alcanzar el límite se usa el template local y la UI explica por qué
# (budgetReason). La app queda utilizable igual; solo deja de gastar.
# Defaults si se dejan vacíos: 20 por hora, 50 por día (piso del demo: 16).
LLM_BUDGET_PER_HOUR=
LLM_BUDGET_PER_DAY=

# ─────────────────────────────────────────────────────────────────────────────
# Sesión de escritura
# ─────────────────────────────────────────────────────────────────────────────
# El listado y los filtros quedan públicos por diseño (la URL se puede compartir);
# escribir exige sesión.
#
# El usuario y la contraseña NO viven acá: viven en la tabla `auth_users` de
# Supabase, con la contraseña hasheada con scrypt (ver supabase/schema.sql y el
# seed en el SQL Editor).
#
# La sesión tampoco: `/api/auth/login` emite un token aleatorio y solo se guarda
# su SHA-256 en la tabla `auth_sessions`. El token viaja en una cookie `HttpOnly`
# que el navegador adjunta solo, así que acá no hay ningún secreto que
# configurar. Lo que sí se puede ajustar:
#
#   - SESSION_TTL_HOURS: duración de la sesión. Default 8 (una jornada). Se
#     acotó a 30 días aunque se pida más.
#   - APP_ORIGIN: origin permitido por el chequeo de CSRF. Opcional: si falta, se
#     usa el origin de la propia request (que en Vercel ya es el público).
#     Fijarlo es lo recomendado si el sitio vive detrás de un proxy.
#
# Probar el login (guardando la cookie):
#   curl -X POST http://localhost:3000/api/auth/login -c jar.txt \
#     -H "Content-Type: application/json" \
#     -d '{"username":"gerente","password":"<PASS>"}'
#   curl -X POST http://localhost:3000/api/auth/verify -b jar.txt
SESSION_TTL_HOURS=
APP_ORIGIN=
