# ─────────────────────────────────────────────────────────────────────────────
# Copiar a .env.local y completar. NUNCA commitear .env.local
# ─────────────────────────────────────────────────────────────────────────────

# URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://yambwmddmtpssvhwbrlx.supabase.co

# Anon key — SOLO lectura. Es publica por diseño: se expone al navegador.
# Va con prefijo NEXT_PUBLIC_ a propósito.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO servidor. bypasea RLS: puede escribir en todas las
# tablas. Si se filtra, hay que rotarla en el dashboard de Supabase.
# SIN prefijo NEXT_PUBLIC_: nunca debe llegar al bundle del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Token de importación
# ─────────────────────────────────────────────────────────────────────────────
# POST /api/import es un endpoint DESTRUCTIVO: reescribe el catálogo. Sin token
# queda cerrado (503) a propósito, porque abierto cualquiera que conozca la URL
# podría reescribir los datos.
#
# Generar uno:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Llamarlo:
#   curl -X POST http://localhost:3000/api/import -H "x-import-token: <TOKEN>"
IMPORT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Borrador IA (opcional) — OpenRouter
# ─────────────────────────────────────────────────────────────────────────────
# La app funciona SIN esto: usa el template local de lib/draft/provider.ts y lo
# marca explícitamente (fromFallback). Solo se hace una llamada real si hay key.
#
# Llamada real (OpenRouter, compatible con la API de OpenAI):
#   LLM_API_KEY=sk-or-v1-...
#   LLM_MODEL=anthropic/claude-3.5-haiku
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#
# LLM_BASE_URL permite apuntar a cualquier proveedor compatible con /chat/completions.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# -------------------------------------------------------------------------------
# Límites de generación IA (protección de costos)
# -------------------------------------------------------------------------------
# La llamada real al proveedor es el único punto que gasta plata. Antes de llamar
# se cuentan los intentos reales de IA de la última hora / 24 h en audit_logs, y
# al alcanzar el límite se usa el template local y la UI explica por qué
# (budgetReason). La app queda utilizable igual; solo deja de gastar.
# Defaults si se dejan vacíos: 20 por hora, 50 por día (piso del demo: 16).
LLM_BUDGET_PER_HOUR=
LLM_BUDGET_PER_DAY=

# ─────────────────────────────────────────────────────────────────────────────
# Sesión de escritura (obligatoria para escribir)
# ─────────────────────────────────────────────────────────────────────────────
# SOLO servidor: DEBE ir sin prefijo NEXT_PUBLIC_. El listado y los filtros
# quedan públicos por diseño (la URL se puede compartir); escribir exige sesión.
#
# El usuario y la contraseña NO viven acá: viven en la tabla `auth_users` de
# Supabase, con la contraseña hasheada con scrypt (ver supabase/schema.sql y
# el seed en el SQL Editor). Lo que sí va en el entorno es el token de sesión:
#
#   - REVIEWS_REPLY_TOKEN: token que devuelve `/api/auth/login` (tras validar
#     usuario/contraseña contra `auth_users`) y que las escrituras
#     (`/api/save-reply`, `/api/generate-draft`) exigen como
#     `Authorization: Bearer <token>`.
#
# Sin este token las escrituras quedan CERRADAS (fail-closed): leer y filtrar
# funciona, pero nadie puede generar borradores ni guardar respuestas.
#
# Generar un token:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Probar el login:
#   curl -X POST http://localhost:3000/api/auth/login \
#     -H "Content-Type: application/json" \
#     -d '{"username":"gerente","password":"<PASS>"}'
REVIEWS_REPLY_TOKEN=
