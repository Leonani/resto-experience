# ─────────────────────────────────────────────────────────────────────────────
# pnpm — configuración del proyecto
# ─────────────────────────────────────────────────────────────────────────────
# La lista de postinstall scripts permitidos NO va acá: pnpm 10 la lee de
# package.json (pnpm.onlyBuiltDependencies). Ver ese archivo.

# Un conflicto de peer dependencies no debe abortar el install. En un proyecto
# con Next 16 y Radix los peers suelen declararse de forma laxa; cortar el
# install por eso deja al equipo sin poder instalar.
strict-peer-dependencies=false

# Deduplica los peers entre paquetes. Sin esto, cada dependencia que depende de
# React instala su propia copia y el árbol se infla.
dedupe-peer-dependents=true

# AVISO: no agregar `shamefully-hoist=true` ni `node-linker=hoisted` para
# "arreglar" un import que no resuelve. El layout aislado de pnpm es parte de la
# razón por la que se eligió: las dependencias transitivas quedan aisladas y no
# se filtran al resolution del proyecto. Si un import no resuelve, el problema
# es una dependencia declarada como ausente en package.json.
